# Copy to .env for local Docker Compose / IDE runs. Demo values only.

# Public URL in Compose: nginx (React + /api proxy) on this host port.
SERVER_PORT=8080

POSTGRES_DB=questkeep
POSTGRES_USER=questkeep
POSTGRES_PASSWORD=questkeep
# Host port mapped to Postgres in Compose (container still listens on 5432).
# Use 5433 if 5432 is already taken (another Docker DB, Homebrew, etc.).
POSTGRES_PORT=5433

DATABASE_URL=jdbc:postgresql://localhost:5433/questkeep
DATABASE_USERNAME=questkeep
DATABASE_PASSWORD=questkeep

ADMINER_PORT=8081

# Structured console logs: ecs | logstash | gelf (empty = disable)
LOGGING_STRUCTURED_FORMAT=ecs

# Auth seed and JWT. Demo only, never production.
STAFF_EMAIL=staff@questkeep.local
STAFF_PASSWORD=ChangeMe_Staff_Demo_1
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
